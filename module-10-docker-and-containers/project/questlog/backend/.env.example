# Copy this file to `.env` (in this same folder) and fill in real values.
# `.env` itself is in `.gitignore` -- it must never be committed, because
# it holds a real secret once you fill SECRET_KEY in for real. This
# example file, with placeholder/non-secret values, IS committed, so
# every learner has a template to start from. See lessons/00-setup.md.

# Only needs to be set if your local Postgres setup differs from the
# default baked into app/config.py (same default Module 06 used).
# DATABASE_URL=postgresql+asyncpg://questlog:questlog_dev_password@localhost:5432/questlog

# REQUIRED. Generate your own with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Never reuse this placeholder for anything real.
SECRET_KEY=replace-this-with-your-own-generated-secret-key

# Optional -- defaults shown below (app/config.py's own defaults).
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=60
# CORS_ORIGINS=http://localhost:5173

# Optional -- NEW in Module 10 (Redis-backed quest-list caching, see
# app/cache.py). Defaults to a local Redis on its default port. Inside
# this module's docker-compose.yml, the backend service instead gets
# REDIS_URL=redis://redis:6379/0 via the compose file's own
# `environment:` block -- see lessons/06-docker-compose-multi-service-apps.md.
# REDIS_URL=redis://localhost:6379/0
