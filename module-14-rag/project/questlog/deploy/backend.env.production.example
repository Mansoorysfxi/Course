# QuestLog backend -- PRODUCTION .env template.
#
# Copy this to /opt/questlog/backend/.env on the real server (never into
# the Git-tracked backend/ folder itself -- this file lives in deploy/
# specifically so it's obviously a template, distinct from
# backend/.env.example, which is the LOCAL-development template Module 07
# already created). Fill in real, freshly-generated values -- never reuse
# any placeholder below. See
# lessons/07-deploying-questlog-part1-server-and-backend.md's "configure
# the backend's real .env" step for exactly how each value here is
# generated and why.

# The `questlog` Postgres role's REAL password, chosen when you create it
# on the server in Lesson 07 -- not the same as this course's local dev
# password (`questlog_dev_password`), which is fine for a machine only
# you can reach but must never be reused on an internet-facing server.
DATABASE_URL=postgresql+asyncpg://questlog:REPLACE_WITH_A_REAL_PASSWORD@localhost:5432/questlog

# REQUIRED. Generate a fresh one directly on the server, the same way
# Module 07 first taught:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Never reuse your local development machine's SECRET_KEY here -- a
# leaked local dev secret should never also compromise your real,
# internet-reachable deployment.
SECRET_KEY=REPLACE_WITH_A_FRESH_GENERATED_SECRET

# Unchanged defaults from Module 07 -- fine to leave as-is.
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Technically no longer load-bearing for browser requests once the
# frontend and backend are served from the same Nginx origin (Lesson 06
# and Lesson 08 explain exactly why -- no cross-origin request exists
# anymore once VITE_API_BASE_URL is built empty). Left set anyway as a
# harmless safety net in case anything ever calls this API directly from
# a different origin (e.g. testing the API from your own laptop with
# curl or an API client rather than through the deployed frontend).
CORS_ORIGINS=http://localhost:5173
