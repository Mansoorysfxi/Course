# Copy this file to `.env`, in this SAME folder (next to
# docker-compose.yml) -- `docker compose` automatically reads a file
# named exactly `.env` here and substitutes its values into
# docker-compose.yml's own `${VARIABLE}` references. This is a DIFFERENT
# `.env` file from `backend/.env` (used only when running the backend
# directly with `uvicorn`, outside Docker entirely) -- see
# lessons/06-docker-compose-multi-service-apps.md's "which .env is this"
# box if the two ever feel confusing.
#
# This file itself IS committed (placeholder values only); the real
# `.env` you create from it is not -- see this folder's .gitignore.

# REQUIRED. docker-compose.yml's SECRET_KEY: ${SECRET_KEY:?...} syntax
# means `docker compose up` refuses to start at all, with a clear error
# naming this exact variable, if it's missing -- generate your own:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-your-own-generated-secret-key

# Optional -- defaults to questlog_dev_password (docker-compose.yml's own
# ${POSTGRES_PASSWORD:-questlog_dev_password} fallback) if not set here.
# Fine for local learning; never reuse this default anywhere reachable
# from outside your own machine.
# POSTGRES_PASSWORD=questlog_dev_password

# Optional -- NEW in Module 11. Leave both unset to run this whole stack
# with Sentry completely off (the normal case for local Compose use) --
# see lessons/06-monitoring-logging-and-error-tracking.md and
# backend/.env.example.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# ENVIRONMENT=development
